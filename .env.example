# Firebase web app config — Firebase Console > Project settings > Your apps.
#
# These are safe to commit to a public build: they identify the project, they
# do not authorise anything. Access is controlled by firestore.rules, by the
# Authentication > Settings > Authorized domains list, and by the allowlist
# below. See FIREBASE_SETUP.md.
#
# Leaving this file unfilled is a supported state: with any value missing the
# app never loads Firebase at all and works exactly as it did before sync —
# local only, with the backup file as the way data moves between devices.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Google addresses allowed to sync.
# EMPTY MEANS ANYBODY — which is what Fulbito is deployed as: sign-up is open,
# and every account can only ever read and write its own data. Fill this in to
# make the app invitational, and put the same list in firestore.rules, which is
# the half that actually enforces it.
VITE_ALLOWED_EMAILS=
