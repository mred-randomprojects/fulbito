rules_version = '2';

// Fulbito — Firestore security rules.
//
// Paste these into Firebase Console > Firestore Database > Rules and Publish.
// They are the real gate. `VITE_ALLOWED_EMAILS` in the app is only a UX gate:
// it decides whether the app offers to sync, and anybody can edit it out of
// their own copy of the JavaScript. These rules cannot be edited by anybody.
//
// Four things are enforced here:
//
//   1. You can only ever touch documents under your own uid. That is what
//      makes an open sign-up safe: every account is an island.
//   2. Optionally, an email allowlist. Leave `allowedEmails()` empty to let
//      anybody with a Google account sync their own roster — the default, and
//      what Fulbito is deployed as. Fill it in to make the app invitational,
//      and keep it in step with the VITE_ALLOWED_EMAILS secret.
//   3. Two addresses, and only those two, may read who sent which ballot. See
//      `isSuperAdmin()` and the `identities` block near the bottom.
//   4. One address — the owner of the site — may *read* under anybody's uid,
//      for "ver como". Never write. See `isSiteOwner()`.
//   5. Four collections live outside `users/{uid}`, because somebody who is
//      not you has to read them: `polls` (an encuesta), `lists` (la lista),
//      `recaps` (el tercer tiempo) and `picks` (la votación de los equipos).
//      Each block says what it pays for that with.

service cloud.firestore {
  match /databases/{database}/documents {

    // Keep in sync with the VITE_ALLOWED_EMAILS GitHub secret.
    // Empty list = anybody signed in may sync their own data.
    function allowedEmails() {
      return [];
    }

    function isAllowedUser() {
      return request.auth != null
        && (allowedEmails().size() == 0
            || request.auth.token.email in allowedEmails());
    }

    // The accounts that may read who sent which ballot. Keep in step with
    // `SUPER_ADMIN_EMAILS` in `src/lib/superAdmin.ts` — that half only
    // decides whether the app offers the switch, and anybody can edit it out
    // of their own copy of the JavaScript. This half is the one that matters.
    //
    // The two people who maintain the app, written here, and deliberately not
    // a field on a document: a privilege that can be granted by editing data
    // is a privilege that gets granted by accident. Lower-case, because the
    // compare below folds the token's case and not this list's.
    //
    // It buys exactly one thing — `polls/{id}/identities` — plus the ability
    // to read the ballots of a poll whose link it holds. It is NOT added to
    // `allow list` on /polls: being able to audit an encuesta you were sent is
    // a different power from being able to enumerate everybody's. (The site
    // owner, below, does get that one — it is the power "Ver como" is.)
    function isSuperAdmin() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'maxiredigonda@gmail.com',
          'bruno.david9914@gmail.com'
        ];
    }

    // The owner of the site: the one account that may read every island, so
    // the app can be opened *as* somebody else when they say it broke. Keep
    // in step with `OWNER_EMAIL` in `src/lib/owner.ts` — that half only
    // decides whether the app offers "Ver como"; this one decides what comes
    // back.
    //
    // A separate list from `isSuperAdmin()` on purpose. Auditing an encuesta
    // somebody sent you and reading every roster in the project are two
    // different powers, and holding one should not quietly grant the other.
    //
    // Read, never write: every rule below that mentions it is an `allow read`
    // or an `allow list`/`get`. A verified address, because an unverified one
    // is a claim anybody can type into a sign-up form.
    function isSiteOwner() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'maxiredigonda@gmail.com';
    }

    // Somebody who signed in as themselves, as against a device that was
    // handed an anonymous session for la lista or el tercer tiempo. An anonymous session is
    // mintable by anybody with the public API key, so "any session" only
    // keeps out crawlers; the encuesta's names and faces, and the one vote
    // per person, are gated on a Google account like they always were.
    function isPerson() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // The account itself: who it says it is, so the owner's "Ver como" has a
    // name to put on a uid. Written by the account's own syncing session and
    // nobody else's, and the address is pinned to the token — a profile
    // cannot claim to be somebody it is not.
    match /users/{userId} {
      allow read: if (isAllowedUser() && request.auth.uid == userId) || isSiteOwner();
      allow create, update: if isAllowedUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'name', 'seenAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.seenAt is string;
      allow delete: if isAllowedUser() && request.auth.uid == userId;
    }

    // One document per record, under the owner's uid:
    //   users/{uid}/players/{playerId}
    //   users/{uid}/matches/{matchId}
    //   users/{uid}/teams/{teamId}
    //   users/{uid}/meta/tombstones
    //   users/{uid}/meta/sync
    match /users/{userId}/{sub}/{document=**} {
      allow read, write: if isAllowedUser() && request.auth.uid == userId;
      allow read: if isSiteOwner();
    }

    // Every account's `meta`, in one query: the owner's directory of who
    // there is to look at. `meta/sync` exists for everybody who ever answered
    // the sync dialog, so this finds accounts that predate their profile.
    match /{path=**}/meta/{docId} {
      allow read: if isSiteOwner();
    }

    // ------------------------------------------------------------------
    // Encuestas — asking other people what your players are worth.
    //
    // The first thing in this app to live outside `users/{uid}` (la lista is
    // the second, el tercer tiempo the third), and every rule here is about paying for that
    // honestly.
    //
    // A poll is a snapshot the owner sends out: names and faces, no ratings.
    // The faces are a subcollection rather than an array on the poll itself,
    // for the same reason the roster is one document per player: an avatar is
    // an inline data URL of up to 60 KB, and twenty of them walk straight
    // into Firestore's 1 MiB document cap. Each one carries `ownerUid` so
    // that writing twenty in one batch costs no rule reads at all — a `get`
    // of the parent poll per document would hit the twenty-access ceiling.
    //
    // A ballot is one person's answers, and it is stored with **no uid on
    // it**. That is not tidiness. The owner has to read every ballot to work
    // out the medians — there is no server here to do it for them — so a uid
    // on the ballot would put "who gave El Gordo a 4" one tap away, and
    // nobody would ever answer honestly again. That is still true: the one
    // place a person and a ballot are written down together is `identities`,
    // which the owner may delete and may never read.
    //
    // One vote per account is enforced by a marker only its own voter can
    // read, and the *order* is the whole trick:
    //
    //   1. The voter creates `voters/{uid}` holding one random `ballotId`.
    //      Create-only: it can never be updated or re-pointed at another.
    //   2. The voter creates `ballots/{ballotId}`, and the rule requires the
    //      id to be exactly the one their own marker names.
    //
    // A marker names one id and cannot change, so an account can only ever
    // write one ballot. Doing it the obvious way round — "you may write a
    // ballot if you have no marker yet" — is broken, and quietly: rules are
    // evaluated against the state *before* the write, so a single batch
    // holding two ballots and one marker passes every check.
    //
    // The email allowlist above deliberately does not apply here. It governs
    // who may sync their own roster; the entire point of a poll is people who
    // are not on that list answering it.
    //
    // Not defended: the owner can list their own poll's ballot ids, so they
    // could point their own marker at one and overwrite it. That is somebody
    // forging the answers to their own question, which costs them their own
    // numbers and nobody else's.
    // ------------------------------------------------------------------
    match /polls/{pollId} {
      function poll() {
        return get(/databases/$(database)/documents/polls/$(pollId)).data;
      }
      function isOwner() {
        return request.auth != null && poll().ownerUid == request.auth.uid;
      }
      function markerPath() {
        return /databases/$(database)/documents/polls/$(pollId)/voters/$(request.auth.uid);
      }
      function claims(ballotId) {
        return request.auth != null
          && exists(markerPath())
          && get(markerPath()).data.ballotId == ballotId;
      }

      // Whoever holds the link, once signed in. A poll carries names and
      // faces, so it is not readable by an unauthenticated crawler that
      // guessed an id, and it is never enumerable by anybody but its owner.
      allow get: if isPerson();
      // The site owner too, for "Ver como": somebody's Encuestas screen is a
      // query for their polls. Not the super admins — see `isSuperAdmin()`.
      allow list: if (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || isSiteOwner();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /players/{playerId} {
        allow read: if isPerson();
        allow create, update: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      match /ballots/{ballotId} {
        // The owner reads the pile to work out the medians. A voter reads
        // exactly the one their marker names, which is how they come back to
        // a ballot they half filled in.
        allow list: if isOwner() || isSuperAdmin() || isSiteOwner();
        allow get: if isOwner() || isSuperAdmin() || isSiteOwner() || claims(ballotId);
        allow create, update: if claims(ballotId)
          && request.resource.data.keys().hasOnly(['votes']);
        allow delete: if isOwner();
      }

      // ----------------------------------------------------------------
      // Who sent which ballot. The exception to everything above, and the
      // narrowest one that answers the question it exists for.
      //
      // The question is whether an encuesta is being trolled. A median
      // absorbs one bad-faith 2 and says nothing about it; two of them move
      // it. Nobody could tell, and there was no way to look.
      //
      // So: a document per ballot, holding the sender's Google address. Three
      // things keep it from undoing the anonymity it sits beside.
      //
      //   1. **The owner cannot read it.** Not `get`, not `list`. This is the
      //      whole point — the anonymity a voter was promised is anonymity
      //      *from the person who made the list*, and that person's access is
      //      unchanged. Only `isSuperAdmin()` reads these.
      //   2. **The address is pinned to the token.** A voter can only ever
      //      write their own, so an identity is evidence rather than a claim.
      //      `name` is not pinned and cannot be — a display name is whatever
      //      the browser sent — so it is a label, never proof.
      //   3. **It is keyed by ballot id, so the owner can delete it blind.**
      //      That is what lets `deletePoll` take these down with everything
      //      else: the owner already knows every ballot id and can derive no
      //      other. Under `voters/{uid}` deleting would have required
      //      enumerating, and "borrar la encuesta" would have been a lie.
      //
      // Writing one is gated on the same `claims()` as the ballot itself, so
      // it can only accompany a ballot this account was entitled to write.
      // ----------------------------------------------------------------
      match /identities/{ballotId} {
        allow get, list: if isSuperAdmin();
        allow create, update: if claims(ballotId)
          && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
          && request.resource.data.email == request.auth.token.email;
        allow delete: if isOwner() || isSuperAdmin();
      }

      match /voters/{voterId} {
        // The door that stays shut. Opening `list` to the owner would put a
        // uid beside every ballot and undo the whole design above.
        allow get: if request.auth != null && request.auth.uid == voterId;
        allow list: if false;
        allow create: if isPerson()
          && request.auth.uid == voterId
          && request.resource.data.keys().hasOnly(['ballotId'])
          && request.resource.data.ballotId is string
          && request.resource.data.ballotId.size() > 0;
        // Never re-pointed: that is what makes one marker mean one vote.
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // La lista — who says they are coming.
    //
    // The second thing outside `users/{uid}`, and the opposite temperament
    // to the encuesta: a "voy" is a public claim made in front of the whole
    // grupo, so nothing here is anonymous *from* anybody. What the rules buy
    // is smaller and simpler:
    //
    //   - Reading needs a session of any kind, so a crawler that guessed an
    //     id gets nothing. The app signs a device in anonymously the moment
    //     the page opens, which is the only sign-in there is on that page.
    //   - An entry is pinned to the uid that wrote it. You may rename or
    //     remove your own names and nobody else's; the organiser may remove
    //     anybody's, and is the only one who may say which player a name is.
    //   - `at` is the server's clock. Arrival order decides who is on the
    //     banco, and a phone with a fast clock would otherwise jump the queue.
    //
    // The list's id is the match's id — random, so nobody squats on one they
    // were not sent, and one match has at most one list without a query.
    //
    // Not defended: a device that clears its storage is a new device, and a
    // troll with the link can put names on the list. The link lives in a
    // private grupo, the organiser can take names off, and the list is
    // shared back into the same chat where everybody can see who did what.
    // That is the same accountability the numbered message always had.
    // ------------------------------------------------------------------
    match /lists/{listId} {
      function list() {
        return get(/databases/$(database)/documents/lists/$(listId)).data;
      }
      function isListOwner() {
        return request.auth != null && list().ownerUid == request.auth.uid;
      }
      function validName(name) {
        return name is string && name.size() > 0 && name.size() <= 40;
      }

      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'title', 'date', 'cap', 'createdAt'])
        && request.resource.data.cap is int
        && request.resource.data.cap >= 2
        && request.resource.data.cap <= 40;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['ownerUid', 'title', 'date', 'cap', 'createdAt'])
        && request.resource.data.cap is int
        && request.resource.data.cap >= 2
        && request.resource.data.cap <= 40;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /entries/{entryId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'uid', 'at'])
          && validName(request.resource.data.name)
          && request.resource.data.at == request.time;
        // Your own name: rename it, nothing else changes. The organiser: say
        // who it is, nothing else changes.
        allow update: if request.auth != null
          && (
            (resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
              && validName(request.resource.data.name))
            || (isListOwner()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerId'])
              && (!('playerId' in request.resource.data) || request.resource.data.playerId is string))
          );
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid || isListOwner());
      }
    }

    // ------------------------------------------------------------------
    // El tercer tiempo — the game, after the game, for the people who
    // played it.
    //
    // The third thing outside `users/{uid}` and the first one that carries
    // what one person *wrote* to another who can read it. The encuesta sends
    // a snapshot out and gets anonymous numbers back; la lista sends a title
    // out and gets names back. This is a comment thread, and the rules here
    // are about the three ways that is different.
    //
    //   - **Reading costs nothing.** Any session, including the anonymous one
    //     the page mints on open, so the link works for whoever it reached
    //     and a crawler that guessed an id still gets nothing. What is behind
    //     it is a snapshot the owner chose to publish — `lib/recap.ts` decides
    //     what that is, and its test pins the field list, because a leak here
    //     is a private note in a group chat and there is no taking it back.
    //
    //   - **Writing is signed, and the signature is pinned.** `isPerson()`,
    //     so a Google account, and `email` must equal the token's. Nothing
    //     here is anonymous and nothing here pretends to be: the page shows
    //     every name to everybody. That is the trade an attributed thread
    //     makes — a median absorbs one bad-faith 2 and absorbs nothing at all
    //     about a sentence, so what keeps this civil is that the grupo can see
    //     who typed it. `name` is whatever the browser sent: a label, never
    //     proof. The address is the proof, and only the owner and the super
    //     admins ever have cause to look at it.
    //
    //   - **One person, one ballot, by shape.** A review lives at
    //     `reviews/{uid}`, so the encuesta's marker-before-ballot dance is
    //     simply absent — that dance exists to keep a uid *off* a ballot, and
    //     these are signed on purpose. A comment is one document each, because
    //     people say more than one thing about a game.
    //
    // A comment cannot be edited, only deleted and written again. An edit
    // leaves no mark, and a thread where somebody can quietly rewrite what a
    // reply was replying to is worse than one where a deletion is visible by
    // its absence.
    //
    // `closed` is the owner saying "that's enough": no new comments, no new
    // ballots, everything already said stays readable. Checked with a `get`
    // of the parent, which costs one rule read per request and is served from
    // cache for every later check in the same one.
    //
    // Not defended: the owner can delete anybody's comment, and nothing says
    // one was there. That is the same power the organiser has over la lista
    // and the same one they have over a WhatsApp group they admin — and the
    // alternative, a tombstone nobody can remove, is a worse feature. The
    // nested contents of a ballot are not validated field by field either:
    // `normalizeReview` is what every reader goes through, and a ballot can
    // only ever speak about somebody the recap itself lists.
    // ------------------------------------------------------------------
    match /recaps/{recapId} {
      function recap() {
        return get(/databases/$(database)/documents/recaps/$(recapId)).data;
      }
      function isRecapOwner() {
        return request.auth != null && recap().ownerUid == request.auth.uid;
      }
      // `closed` is absent until somebody shuts the thread, and reading a
      // field that is not there is an evaluation error rather than a false —
      // which, before `get` with a default, meant a freshly published recap
      // accepted no comments at all. `rules.test.ts` is what caught that.
      function isOpen() {
        return recap().get('closed', false) != true;
      }
      // Signed by the account writing it. The *address* is deliberately not
      // here — see the `identities` block at the bottom: everything else under
      // a recap is readable by whoever holds the link, so a mail on a comment
      // would be a mail published to the whole grupo.
      function signsOwnName() {
        return isPerson()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
      }

      // Whoever holds the link, once they have any session at all.
      allow get: if request.auth != null;
      // Never enumerable by anybody but the owner. The site owner too, so
      // "Ver como" can see somebody's own matches as they see them.
      allow list: if (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || isSiteOwner();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['ownerUid', 'title', 'date', 'goalsA', 'goalsB', 'a', 'b',
              'videos', 'createdAt', 'closed', 'ignored'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.goalsA is int
        && request.resource.data.goalsB is int;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(
             ['ownerUid', 'title', 'date', 'goalsA', 'goalsB', 'a', 'b',
              'videos', 'createdAt', 'closed', 'ignored']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // The faces, one document each: an avatar is an inline data URL of up
      // to 60 KB and twenty on one document cross Firestore's 1 MiB cap.
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if signsOwnName()
          && isOpen()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 600
          && request.resource.data.at == request.time;
        // See the note above: deleted and written again, never edited.
        allow update: if false;
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid || isRecapOwner());
      }

      // One per person, and the document id is who. A ballot is rewritable
      // by its own author on purpose: a puntaje typed before the video went
      // up is one somebody is entitled to revise.
      match /reviews/{voterId} {
        allow read: if request.auth != null;
        allow create, update: if signsOwnName()
          && request.auth.uid == voterId
          && isOpen()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'mvp', 'players', 'at'])
          && (!('mvp' in request.resource.data) || request.resource.data.mvp is string)
          && request.resource.data.players is map
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null
          && (request.auth.uid == voterId || isRecapOwner());
      }

      // ----------------------------------------------------------------
      // Who these names actually are. The only thing under a recap that
      // whoever holds the link cannot read.
      //
      // Everything else here is published on purpose — the scoreline, the
      // faces, the puntajes, every comment with a name on it. A mail is not,
      // and the page says so in as many words, so it is a sibling document
      // rather than a field: a field on a comment is readable by everybody who
      // can read the comment, and that is the entire grupo plus whoever they
      // forwarded the link to.
      //
      // Read by the recap's owner — who is moderating a thread and is entitled
      // to know which account is behind a name — and by the super admins, who
      // maintain the app. By nobody else, including the other people who
      // played. Written only by its own account, with the address pinned to
      // the token, so it is evidence rather than a claim; `name` is not pinned
      // and cannot be, because a display name is whatever the browser sent.
      //
      // Keyed by uid rather than per comment: an account is one person however
      // many times they post, and the owner can take these down with the recap
      // because they are allowed to list them — unlike an encuesta's, where
      // the whole point is that the owner may delete what they may not read.
      // ----------------------------------------------------------------
      match /identities/{voterId} {
        allow get, list: if isRecapOwner() || isSuperAdmin();
        allow create, update: if isPerson()
          && request.auth.uid == voterId
          && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null
          && (request.auth.uid == voterId || isRecapOwner() || isSuperAdmin());
      }
    }

    // ------------------------------------------------------------------
    // La votación — which of the six splits we play.
    //
    // The fourth thing outside `users/{uid}`, and a fourth temperament. The
    // encuesta is private and anonymous, la lista is public and asks for
    // nothing, el tercer tiempo is public and asks for a name. This is
    // anonymous *and* public: a vote for an arrangement of ten people is
    // nobody's confession, so there is no name on a ballot, no `identities`
    // collection, and no address written down anywhere.
    //
    //   - **Reading costs a session of any kind**, which the page mints
    //     anonymously on open, so the link works for whoever it reached and a
    //     crawler that guessed an id gets nothing. What is behind it is the
    //     two side names, the bibs and who is on which side: `lib/teamPick.ts`
    //     decides that, its test pins the field list, and the `hasOnly` below
    //     is the second lock. **No rating, no team total and no balance index
    //     ever goes out** — a total is ten ratings anybody can nearly invert,
    //     and a page saying which option the app prefers is a page where the
    //     vote is a formality.
    //
    //   - **The ballots are readable by whoever holds the link.** There is no
    //     server here to add them up, so the page does it. The screen holds the
    //     counts back until you have voted — that is manners, not a wall, and
    //     it is there so the first three votes do not decide the rest.
    //
    //   - **One ballot per device, by shape.** It lives at `ballots/{uid}`,
    //     writable by that uid alone and rewritable by it: somebody who ticks a
    //     fourth option is still answering once.
    //
    //   - **`options` can never change.** `allow update` lets the organiser
    //     touch the title, the date and their own words about the vote —
    //     `closed`, `chosen`, `drawn` — and nothing else, so there is no
    //     republish and no way for "voté la 3" to become a vote for teams that
    //     device never saw. Changing the options means deleting the votación
    //     and holding another one.
    //
    // `chosen` is the option that got played, and `drawn` says it came out of
    // the sorteo rather than off the top of the count. Both are the organiser's
    // word, written when they pick, and they shut the vote in the same write.
    //
    // Not defended: a ballot's numbers are not checked against the options that
    // exist — `normalizeBallot` is what every reader goes through, and an index
    // pointing at nothing counts for nothing. And a device that clears its
    // storage is a new device, the same hole la lista has, with the same
    // answer: the link lives in a private grupo and the organiser can take the
    // whole thing down.
    // ------------------------------------------------------------------
    match /picks/{pickId} {
      function pick() {
        return get(/databases/$(database)/documents/picks/$(pickId)).data;
      }
      function isPickOwner() {
        return request.auth != null && pick().ownerUid == request.auth.uid;
      }
      // `closed` is absent until somebody shuts the vote, and reading a field
      // that is not there is an evaluation error rather than a false — the
      // same trap `isOpen()` on a recap fell into, caught by `rules.test.ts`.
      function isOpen() {
        return pick().get('closed', false) != true;
      }

      allow get: if request.auth != null;
      // Never enumerable by anybody but the organiser. The site owner too, so
      // "Ver como" sees somebody's own matches as they see them.
      allow list: if (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || isSiteOwner();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['ownerUid', 'title', 'date', 'options', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 8;
      // The options are not on this list, and that is the whole rule.
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'date', 'closed', 'chosen', 'drawn'])
        && (!('chosen' in request.resource.data) || request.resource.data.chosen is int);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // The faces, one document each: an avatar is an inline data URL of up
      // to 60 KB and twenty on one document cross Firestore's 1 MiB cap.
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      match /ballots/{voterId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == voterId
          && isOpen()
          && request.resource.data.keys().hasOnly(['options', 'at'])
          && request.resource.data.options is list
          && request.resource.data.options.size() > 0
          && request.resource.data.options.size() <= 8
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null
          && (request.auth.uid == voterId || isPickOwner());
      }
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
